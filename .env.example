# "mock" needs no API key. Use "real" to call the provider below.
AI_PROVIDER=mock

# Base URL up to /v1. The code will append /chat/completions itself.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string

DATABASE_URL=sqlite:///./kadak.db